rule gcc
   command = python3 ../../tools/deps-gcc.py -o ${out} -MF ${depfile} -c ${in}
   deps = gcc
   depfile = ${out}.d

# Output order issue: types.h is primary output in ninja edge,
# but handler (or 2PC / REAPI sorting) makes hwtypes.h first in cmd.outputs.
build types.h hwtypes.h: gcc ../../base/foo.cc || ../../tools/deps-gcc.py
   depfile = types.h.d

build all: phony types.h hwtypes.h
