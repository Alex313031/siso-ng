rule myrule
    command = ../../toybox touch $out.d $out
    deps = gcc
    depfile = $out.d

build toybox_phony: phony ../../toybox
build toybox_inputs_deps: phony ../../in.1 ../../in.2

build a.cc: myrule toybox_phony ../../in || toybox_inputs_deps
