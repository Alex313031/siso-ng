rule unzip
  command = python3 ../../tools/unzip.py ${in} ${out_dir}

rule mkzip
  command = python3 ../../tools/mkzip.py ${out} ${in_dir}

build obj/extracted/: unzip ../../input.zip
  out_dir = obj/extracted

build obj/repackaged.zip: mkzip obj/extracted/
  in_dir = obj/extracted

build all: phony obj/repackaged.zip

build build.ninja: phony
