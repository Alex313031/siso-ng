rule unzip
  command = python3 ../../tools/unzip.py ${in} ${out_dir}

rule mkzip
  command = python3 ../../tools/mkzip.py ${out} ${in_dir}

# tools/unzip.py is declared as an implicit input (after |) so it
# is uploaded to the remote action's input root. The host PATH
# resolves python3.
build obj/extracted/: unzip ../../input.zip | ../../tools/unzip.py
  out_dir = obj/extracted

build obj/repackaged.zip: mkzip obj/extracted/ | ../../tools/mkzip.py
  in_dir = obj/extracted

build all: phony obj/repackaged.zip

build build.ninja: phony
