rule mkdir
  command = mkdir -p ${out}

rule mkzip
  command = ../../toybox touch ${out}

build input_dir/: mkdir

build obj/repackaged.zip: mkzip input_dir/
  in_dir = input_dir

build all: phony obj/repackaged.zip
build build.ninja: phony
