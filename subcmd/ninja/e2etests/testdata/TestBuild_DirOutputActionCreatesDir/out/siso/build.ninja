rule copytree
   command = python3 ../../tools/copytree.py --out_dir=${out_dir} ../../src

build copytree/: copytree ../../src/foo.txt | ../../tools/copytree.py
  out_dir = copytree

build all: phony copytree/

build build.ninja: phony
