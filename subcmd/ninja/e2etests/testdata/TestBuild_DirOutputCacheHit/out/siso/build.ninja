rule genmixed
  command = python3 ../../tools/genmixed.py --out=${out_file} --out_dir=${out_dir} ${in}

build out.txt gen/: genmixed ../../base/input | ../../tools/genmixed.py
  out_file = out.txt
  out_dir = gen

build all: phony out.txt gen/

build build.ninja: phony
