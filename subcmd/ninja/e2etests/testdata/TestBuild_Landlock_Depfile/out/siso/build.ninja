rule action
  command = /bin/sh -c "mkdir -p obj && echo content > obj/foo.o && echo 'obj/foo.o: ../../foo.cc ../../declared.h ../../undeclared.h' > obj/foo.o.d"
  depfile = obj/foo.o.d

build obj/foo.o: action ../../foo.cc myphony

build myphony: phony ../../declared.h
