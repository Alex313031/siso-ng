# should not fail remotely due to missing ../../foo/deps/include
# (actually storing entry would fail because ../../foo/DEPS exists.)
rule cxx
    command = ../../clang -MM -MF $out.d -I../../foo/deps/include -c $in -o $out
    deps = gcc
    depfile = $out.d

build obj/foo/foo.o: cxx ../../foo/foo.c
