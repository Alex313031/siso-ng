# A (remote) produces out0 and out1 from input.
# B (local) consumes out0 and produces out2.
# out1 has no consumer (the .dwo analog).
# With -output_local_strategy=graph, out0 (consumed by a local step) is
# materialized to local disk and out1 (consumed by nobody) is left in CAS.

rule A
  command = python3 ../../action.py --input input --output out0 --output1 out1

rule B
  command = python3 ../../action.py --input out0 --output out2

build out0 out1: A ../../input
build out2: B out0
default out2
