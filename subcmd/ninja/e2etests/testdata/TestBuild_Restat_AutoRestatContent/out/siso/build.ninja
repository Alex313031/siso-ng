rule action
   command = python3 ../../tools/action.py --output=${out} ${in}
   restat = 1

# tools/action.py is declared as an implicit input so it is uploaded
# to the remote action's input root.
build foo.out: action ../../base/foo.in | ../../tools/action.py
build bar.out: action ../../base/bar.in foo.out | ../../tools/action.py

# explicit restat_content = false wins over auto-restat-content.
build baz.out: action ../../base/baz.in | ../../tools/action.py
  restat_content = false
build qux.out: action ../../base/qux.in baz.out | ../../tools/action.py

build all: phony bar.out qux.out

build build.ninja: phony
