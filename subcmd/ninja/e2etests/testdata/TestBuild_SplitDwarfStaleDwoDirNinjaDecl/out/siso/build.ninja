rule link
   command = python3 ../../tools/lld.py -gsplit-dwarf -flto=thin --out=libfoo.so ${in}

rule dump_syms
   command = python3 ../../tools/dump_syms.py --out=${out} ${in}

build libfoo.so libfoo.so-dwo/: link ../../base/units | ../../tools/lld.py

build libfoo.so.sym: dump_syms libfoo.so | ../../tools/dump_syms.py

build all: phony libfoo.so.sym

build build.ninja: phony
