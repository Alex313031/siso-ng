# gendir (local, two phase caching) creates gen/ from the names manifest. It
# never clears gen/ itself, so only siso can remove members a smaller tree drops.

rule gendir
   command = python3 ../../tools/gendir.py --output=${out_dir} ../../base/names

build gen/: gendir ../../base/names | ../../tools/gendir.py
  out_dir = gen

build all: phony gen/

build build.ninja: phony
