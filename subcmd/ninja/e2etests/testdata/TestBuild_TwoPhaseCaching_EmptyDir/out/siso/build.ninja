rule gen
   command = python3 ../../tools/gen.py --output=${out} --mkdir=empty_dir ${in}

rule verify
   command = python3 ../../tools/verify.py --output=${out} --check-dir=empty_dir ${in}

build foo.out: gen ../../base/foo.in
build bar.out: verify foo.out

build all: phony bar.out

build build.ninja: phony
