rule gen
   command = python3 ../../tools/gen.py --output=${out} ${in} ../../base/read_order_only.in

build tool-deps: phony ../../tools/gen.py
build oo-deps: phony ../../base/unread_via_phony.in
build foo.out: gen ../../base/foo.in | tool-deps || ../../base/unread.in ../../base/read_order_only.in oo-deps
build all: phony foo.out
build build.ninja: phony
