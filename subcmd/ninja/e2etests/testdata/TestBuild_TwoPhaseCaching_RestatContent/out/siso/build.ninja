rule gcc
   command = python3 ../../tools/deps-gcc.py -o ${out} -MF ${depfile} -c ${in}
   deps = gcc
   depfile = ${out}.d
   restat = 1

rule action
   command = python3 ../../tools/action.py --output=${out} ${in}
   restat = 1

build foo.o: gcc ../../base/foo.cc
build bar.out: action foo.o

build all: phony bar.out

build build.ninja: phony
