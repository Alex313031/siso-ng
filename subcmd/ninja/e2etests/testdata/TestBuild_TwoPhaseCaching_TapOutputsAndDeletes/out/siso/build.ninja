rule gen
   command = python3 ../../tools/gen.py --unlink-output=${out} --output=undeclared.out --unlink-output=undeclared_recreated.out --temp-file=temp.tmp ${in}

rule verify
   command = python3 ../../tools/verify.py --output=${out} --check-file=undeclared.out --check-file=undeclared_recreated.out ${in}

build foo.out: gen ../../base/foo.in
build bar.out: verify foo.out

build all: phony bar.out

build build.ninja: phony
